# Keep a small in-memory diagnostic log so users can report audio-hook failures.
_LOG_LOCK=threading.RLock()
_LOG_LINES=[]
_LOG_LIMIT=300

def log(message):
    try:
        line=str(message)
        with _LOG_LOCK:
            _LOG_LINES.append("%s | %s"%(time.strftime("%H:%M:%S"),line))
            if len(_LOG_LINES)>_LOG_LIMIT:
                del _LOG_LINES[:-_LOG_LIMIT]
    except Exception:
        pass
    try:
        _host_log(str(message))
    except Exception:
        pass

def get_diagnostic_log():
    with _LOG_LOCK:
        return "\n".join(_LOG_LINES[-_LOG_LIMIT:]) or "Журнал поки порожній."


