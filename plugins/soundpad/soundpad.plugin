import os, struct, threading, time
from array import array
from typing import Any, List
from base_plugin import BasePlugin, MethodHook
from android_utils import OnClickListener, run_on_ui_thread, log
from file_utils import ensure_dir_exists, get_plugins_dir
from hook_utils import find_class
from ui.settings import Header, Divider, Input, Selector, Switch, Text
from android.graphics import Color
